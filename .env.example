APP_ENV=development
HTTP_ADDR=:8080
APP_VERSION=phase02
GIN_MODE=release
DATABASE_URL=postgres://ecom:ecom_local_only@localhost:55432/ecom?sslmode=disable
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_local_only
POSTGRES_DB=ecom
POSTGRES_PORT=55432
API_PORT=8080
FRONTEND_PORT=8081
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
DB_TIMEOUT=3s
SEED_STORE_NAME=E-commerce Base
SEED_SHIPPING_FEE_VND=30000

# Generate locally with: openssl rand -hex 32
AUTH_JWT_SECRET=
REDIS_URL=redis://127.0.0.1:56379/0
RATE_LIMIT_PREFIX=ecommerce:rate:
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.test
SEED_CUSTOMER_PASSWORD=
